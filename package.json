{
  "name": "recast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --port 8787",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "preview": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dompurify": "latest",
    "lucide-react": "latest",
    "marked": "latest",
    "react": "latest",
    "react-dom": "latest",
    "youtube-transcript-plus": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "prettier": "^3.10.1",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
