{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recast-xvc",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "AI_PROVIDER": "deepseek", "AI_MODEL": "deepseek-flash" },
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "ArticleSession" },
      { "name": "TRANSCRIPTS", "class_name": "TranscriptCache" },
      { "name": "QUOTAS", "class_name": "Quota" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ArticleSession", "Quota"] },
    { "tag": "v2", "new_sqlite_classes": ["TranscriptCache"] },
  ],
}
